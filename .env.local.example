# Copy this file to .env.local for local development, and add the same
# values in Vercel → Project → Settings → Environment Variables for
# deployment. Never commit the real .env.local — it's gitignored.

# From your project at https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-06-01

# Invent this secret yourself (any random string), then enter it in two
# places: here, and in Sanity → your project → API → Webhooks → the
# webhook you create pointing at /api/webhooks/sanity → "Secret" field.
SANITY_REVALIDATE_SECRET=
